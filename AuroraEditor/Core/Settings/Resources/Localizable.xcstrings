          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hmmm... Sepertinya Sangat Kesepian Di Sini, Sepertinya Tidak Ada Pekerjaan Yang Dilakukan."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verkar väldigt ensam här, inga jobb gjorda det ser ut som."
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "On dirait qu'il y a beaucoup de solitude ici, il semble qu'aucun travail n'ait été effectué.",
            "state" : "translated"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ồ... Có vẻ rất cô đơn ở đây, không có công việc được thực hiện như vậy."
          }
        },
        "ar-AE" : {
          "stringUnit" : {
            "state" : "translated",
