    "We limit the amount of items that is shown in the commit list to improve performance" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "value" : "Limitiamo la quantità di articoli che viene mostrata nell'elenco dei commit per migliorare le prestazioni.",
            "state" : "translated"
          }
        },
        "id" : {
          "stringUnit" : {
            "value" : "Kami membatasi jumlah item yang ditampilkan dalam daftar komitmen untuk meningkatkan kinerja",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att förbättra prestandan har vi begränsat antalet artiklar som visas i commit-listan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Performansı artırmak için taahhüt listesinde gösterilen öğelerin miktarını sınırlıyoruz."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nós limitamos a quantidade de itens que é mostrada na lista de commit para melhorar o desempenho."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们限制提交列表中显示的项目数量，以提高性能。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chúng tôi hạn chế số lượng mặt hàng được hiển thị trong danh sách cam kết để cải thiện hiệu suất"
          }
        },
        "uk-UA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ми обмежуємо кількість елементів, які відображаються у списку комітів, щоб покращити продуктивність"
          }
        },
        "es-US" : {
          "stringUnit" : {
            "value" : "Limitamos la cantidad de artículos que se muestran en la lista de compromisos para mejorar el rendimiento.",
            "state" : "translated"
          }
        },
        "it-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per migliorare le prestazioni, limitiamo la quantità di articoli visualizzati nell'elenco commit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "value" : "Ograniczamy ilość elementów wyświetlanych na liście commitów, aby poprawić wydajność",
            "state" : "translated"
          }
        },
        "ko-KR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "성능향상을 위해 체크리스트에 표시되는 항목의 양을 제한합니다."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "value" : "Pour améliorer les performances, nous limitons le nombre d'articles affichés dans la liste des dépôts.",
            "state" : "translated"
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "Nous limitons la quantité d'articles qui sont affichés dans la liste des dépôts pour améliorer les performances.",
            "state" : "translated"
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "value" : "Limitamos la cantidad de artículos que se muestran en la lista de commit para mejorar el rendimiento.",
            "state" : "translated"
          }
        },
        "hi-IN" : {
          "stringUnit" : {
            "value" : "हम प्रदर्शन में सुधार के लिए कमिट सूची में दिखाए गए आइटम की मात्रा को सीमित करते हैं",
            "state" : "translated"
          }
        },
        "ar-AE" : {
          "stringUnit" : {
            "value" : "نحن نحد من كمية العناصر المعروضة في قائمة الالتزام لتحسين الأداء",
            "state" : "translated"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
