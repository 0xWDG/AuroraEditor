    "Click Reopen to open the application again. This report will be sent automatically to the AuroraEditor team." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik Buka Kembali untuk membuka aplikasi lagi. Laporan ini akan dikirim secara otomatis ke tim AuroraEditor."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "單擊重新開啟以再次開啟應用程式。此報告將自動傳送到AuroraEditor團隊。"
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "value" : "Klikk på Åpne på nytt for å åpne applikasjonen på nytt. Denne rapporten vil automatisk bli sendt til AuroraEditor-teamet.",
            "state" : "translated"
          }
        },
        "hi-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एप्लिकेशन को फिर से खोलने के लिए फिर से खोलें पर क्लिक करें। यह रिपोर्ट ऑरोरा एडिटर टीम को स्वचालित रूप से भेजी जाएगी।"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse Reabrir para volver a abrir la aplicación. Este informe será enviado automáticamente al equipo de AuroraEditor."
          }
        },
        "uk-UA" : {
          "stringUnit" : {
            "value" : "Натисніть кнопку Повторно відкрити, щоб знову відкрити програму. Цей звіт буде автоматично надіслано команді AuroraEditor.",
            "state" : "translated"
          }
        },
        "ja-JP" : {
          "stringUnit" : {
            "value" : "アプリケーションを再度開くには、[再開]をクリックしてください。このレポートは、AuroraEditorチームに自動的に送信されます。",
            "state" : "translated"
          }
        },
        "ru" : {
          "stringUnit" : {
            "value" : "Нажмите «Открыть», чтобы снова открыть приложение. Этот отчет будет автоматически отправлен команде AuroraEditor.",
            "state" : "translated"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คลิกเปิดใหม่เพื่อเปิดแอปพลิเคชันอีกครั้ง รายงานนี้จะถูกส่งไปยังทีม AuroraEditor โดยอัตโนมัติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamayı tekrar açmak için Yeniden Aç'a tıklayın. Bu rapor otomatik olarak AuroraEditor ekibine gönderilecektir."
          }
        },
        "pl" : {
          "stringUnit" : {
            "value" : "Kliknij Otwórz ponownie, aby ponownie otworzyć aplikację. Ten raport zostanie wysłany automatycznie do zespołu AuroraEditor.",
            "state" : "translated"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fare clic su riapri per aprire nuovamente l'applicazione. Questo rapporto verrà inviato automaticamente al team di AuroraEditor."
          }
        },
        "ko-KR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "응용 프로그램을 다시 열려면 다시 열을 클릭하세요. 이 보고서는 자동으로 AuroraEditor 팀으로 전송됩니다."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicken Sie auf Wieder öffnen, um die Anwendung erneut zu öffnen. Dieser Bericht wird automatisch an das AuroraEditor-Team gesendet."
          }
        },
        "pt" : {
          "stringUnit" : {
            "value" : "Clique em Reabrir para abrir a aplicação novamente. Este relatório será enviado automaticamente para a equipa da AuroraEditor.",
            "state" : "translated"
          }
        },
        "ar-AE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر فوق إعادة فتح لفتح التطبيق مرة أخرى. سيتم إرسال هذا التقرير تلقائيا إلى فريق AuroraEditor."
          }
        },
        "it-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic su Ripristina per aprire nuovamente l'applicazione. Questo rapporto verrà inviato automaticamente al team di AuroraEditor."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "value" : "Cliquez sur Ouvrir à nouveau pour ouvrir l'application. Ce rapport sera envoyé automatiquement à l'équipe d'AuroraEditor.",
            "state" : "translated"
          }
        },
        "da" : {
          "stringUnit" : {
            "value" : "Klik på Genåbn for at åbne applikationen igen. Denne rapport sendes automatisk til AuroraEditor-teamet.",
            "state" : "translated"
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en Reabrir para volver a abrir la aplicación. Este informe se enviará automáticamente al equipo de AuroraEditor."
          }
        },
        "zh-Hans" : {
