        "vi" : {
          "stringUnit" : {
            "value" : "Đã vô hiệu hóa thông báo. Bật thông báo trong cài đặt để tiếp tục nhận thông báo.",
            "state" : "translated"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уведомления были отключены. Включите уведомления в настройках, чтобы продолжать получать уведомления."
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "Les notifications ont été désactivées. Activez les notifications dans les paramètres pour continuer à recevoir des notifications.",
            "state" : "translated"
          }
        },
        "it-CH" : {
          "stringUnit" : {
            "value" : "Le notifiche sono state disattivate. Attiva le notifiche nelle impostazioni per continuare a riceverle.",
            "state" : "translated"
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "value" : "Varsler er deaktivert. Aktiver varsler i innstillingene for å fortsette å motta varsler.",
            "state" : "translated"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "value" : "As notificações foram desativadas. Ative as notificações nas configurações para continuar recebendo notificações.",
            "state" : "translated"
          }
        },
        "es" : {
          "stringUnit" : {
            "value" : "Las notificaciones se han desactivado. Activa las notificaciones en la configuración para seguir recibiendo notificaciones.",
            "state" : "translated"
          }
        },
        "ar-AE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تعطيل الإشعارات. قم بتمكين الإشعارات في الإعدادات لمواصلة تلقي الإشعارات."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "value" : "Las notificaciones se han desactivado. Activa las notificaciones en la configuración para seguir recibiendo notificaciones.",
            "state" : "translated"
          }
        },
        "uk-UA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сповіщення відключено. Увімкніть сповіщення в налаштуваннях, щоб продовжувати отримувати сповіщення."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "value" : "Les notifications ont été désactivées. Activez les notifications dans les paramètres pour continuer à recevoir des notifications.",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meddelanden har inaktiverats. Aktivera meddelanden i inställningarna för att fortsätta ta emot meddelanden."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การแจ้งเตือนถูกปิดใช้งาน เปิดใช้งานการแจ้งเตือนในการตั้งค่าเพื่อรับการแจ้งเตือนต่อไป"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldingen zijn uitgeschakeld. Schakel meldingen in de instellingen in om meldingen te blijven ontvangen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifikationer er blevet deaktiveret. Aktivér notifikationer i indstillingerne for at fortsætte med at modtage notifikationer."
          }
        },
        "hi-IN" : {
          "stringUnit" : {
            "value" : "सूचनाएं अक्षम कर दी गई हैं। सूचनाएं प्राप्त करना जारी रखने के लिए सेटिंग्स में सूचनाएं सक्षम करें।",
            "state" : "translated"
          }
        },
        "de-CH" : {
          "stringUnit" : {
            "value" : "Benachrichtigungen sind deaktiviert. Bitte aktivieren Sie Benachrichtigungen in den Einstellungen, um Benachrichtigungen weiterhin zu erhalten.",
            "state" : "translated"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemberitahuan telah dinonaktifkan. Aktifkan pemberitahuan dalam pengaturan untuk terus menerima pemberitahuan."
