    "All uncommited changes will be preserved on the renamed branch." : {
      "localizations" : {
        "zh-Hant" : {
          "stringUnit" : {
            "value" : "所有未提交的更改都將儲存在重新命名後的分支中。",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla oförpliktade ändringar bevaras på den omdöpta grenen."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los cambios no comprometidos se conservarán en la rama rebautizada."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "value" : "Alle ikke-forpliktede endringer vil bli bevart på den omdøpte grenen.",
            "state" : "translated"
          }
        },
        "th" : {
          "stringUnit" : {
            "value" : "การเปลี่ยนแปลงที่ไม่มีข้อผูกมัดทั้งหมดจะถูกเก็บรักษาไว้ในสาขาที่เปลี่ยนชื่อ",
            "state" : "translated"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as mudanças não comprometidas serão preservadas no ramo renomeado."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as alterações não comprometidas serão preservadas na ramificação renomeada."
          }
        },
        "ar-AE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم الاحتفاظ بجميع التغييرات غير الملتزم بها في الفرع الذي تمت إعادة تسميته."
          }
        },
        "hi-IN" : {
          "stringUnit" : {
            "value" : "सभी ग़ैर-प्रतिबद्ध परिवर्तन पुनः नामित शाखा पर संरक्षित किए जाएंगे।",
            "state" : "translated"
          }
        },
        "ja-JP" : {
          "stringUnit" : {
            "value" : "コミットされていない変更はすべて、名前が変更されたブランチに保存されます。",
            "state" : "translated"
          }
        },
        "it-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutte le modifiche non effettuate verranno conservate sul ramo rinominato."
          }
        },
        "uk-UA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всі незаконані зміни будуть збережені в перейменованій гілці."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle ikke-forpligtende ændringer vil blive gemt på den omdøbnede gren."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有未提交的更改都将保存在重命名的分支上。"
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "Tous les changements non engagés seront conservés sur la branche renommée.",
            "state" : "translated"
          }
        },
        "tr" : {
          "stringUnit" : {
            "value" : "Tüm taahhüt edilmemiş değişiklikler yeniden adlandırılan şubede korunacaktır.",
            "state" : "translated"
          }
        },
        "vi" : {
          "stringUnit" : {
            "value" : "Mọi thay đổi không được cam kết sẽ được lưu giữ trên nhánh đã được đổi tên.",
