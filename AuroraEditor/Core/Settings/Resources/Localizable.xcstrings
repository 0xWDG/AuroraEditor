    "Disabling syntax highlighting can improve performance by reducing the processing required to render the text editor, especially for large files." : {
      "localizations" : {
        "ja-JP" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "構文ハイライトを無効にすると、テキストエディタをレンダリングするために必要な処理を最小限に抑えることができるため、パフォーマンスが向上します。特に大きなファイルの場合。"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menonaktifkan penyorotan sintaks dapat meningkatkan kinerja dengan mengurangi pemrosesan yang diperlukan untuk membuat editor teks, terutama untuk file besar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "value" : "禁用语法高亮显示可以通过减少渲染文本编辑器的处理要求来提高性能，特别是对于大文件。",
            "state" : "translated"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การปิดใช้งานการเน้นไวยากรณ์สามารถปรับปรุงประสิทธิภาพโดยการลดการประมวลผลที่จําเป็นในการเรนเดอร์โปรแกรมแก้ไขข้อความ โดยเฉพาะอย่างยิ่งสําหรับไฟล์ขนาดใหญ่"
          }
        },
        "it" : {
          "stringUnit" : {
            "value" : "Disabilitare l'evidenziazione sintassi può migliorare le prestazioni riducendo l'elaborazione richiesta per rendere l'editor di testo, soprattutto per i grandi file.",
            "state" : "translated"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключение выделения синтаксиса может повысить производительность за счет сокращения обработки, необходимой для отображения текстового редактора, особенно для больших файлов."
          }
        },
        "ar-AE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن أن يؤدي تعطيل تمييز بناء الجملة إلى تحسين الأداء عن طريق تقليل المعالجة المطلوبة لعرض محرر النصوص، خاصة بالنسبة للملفات الكبيرة."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "value" : "Desativar a realce de sintaxe pode melhorar o desempenho ao reduzir o processamento necessário para renderizar o editor de texto, especialmente para arquivos grandes.",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "Die Deaktivierung der Syntaxhervorhebung kann die Leistung verbessern, indem sie die Verarbeitung, die für die Darstellung des Texteditors erforderlich ist, reduziert, insbesondere bei großen Dateien.",
            "state" : "translated"
          }
        },
        "es-US" : {
          "stringUnit" : {
            "value" : "Desactivar el resaltado de la sintaxis puede mejorar el rendimiento al reducir el procesamiento requerido para mostrar el editor de texto, especialmente para archivos grandes.",
            "state" : "translated"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La désactivation de l’overscriture de syntaxe peut améliorer les performances en réduisant le traitement nécessaire pour afficher l’éditeur de texte, surtout pour les fichiers volumineux."
          }
        },
        "uk-UA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відключення підсвічування синтаксису може підвищити продуктивність, зменшивши обробку, необхідну для відображення текстового редактора, особливо для великих файлів."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att inaktivera syntaxmarkering kan förbättra prestandan genom att minska bearbetningskostnaden för att visa textredigeraren, särskilt för stora filer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sözdizim vurgulamasının devre dışı bırakılması, özellikle büyük dosyalar için metin düzenleyicisini oluşturmak için gereken işleyişi azaltarak performansı artırabilir."
          }
        },
        "es" : {
          "stringUnit" : {
            "value" : "Desactivar la resaltación de la sintaxis puede mejorar el rendimiento al reducir el procesamiento requerido para mostrar el editor de texto, especialmente para archivos grandes.",
            "state" : "translated"
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "value" : "Desactivar el resaltado de la sintaxis puede mejorar el rendimiento al reducir el procesamiento requerido para mostrar el editor de texto, especialmente para archivos grandes.",
            "state" : "translated"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktivering af syntaksmarkering kan forbedre ydeevnen ved at reducere den behandling, der kræves for at gengive teksteditoren, især for store filer."
          }
        },
        "ko-KR" : {
          "stringUnit" : {
            "value" : "구현할 텍스트 편집기를 렌더링하는 데 필요한 처리량을 줄여, 특히 큰 파일의 성능을 향상시킬 수 있습니다.",
            "state" : "translated"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het uitschakelen van syntaxische markering kan de prestaties verbeteren door de verwerking die nodig is om de teksteditor weer te geven te verminderen, vooral voor grote bestanden."
          }
        },
        "de-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Deaktivierung der Syntaxhervorhebung kann die Leistung verbessern, indem sie die Verarbeitung für die Darstellung des Texteditors reduziert, insbesondere bei grossen Dateien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłączenie podświetlania składni może poprawić wydajność poprzez zmniejszenie przetwarzania wymaganego do renderowania edytora tekstu, szczególnie w przypadku dużych plików."
          }
        },
        "it-CH" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La disattivazione dell'evidenziazione sintattica può migliorare le prestazioni riducendo l'elaborazione necessaria per visualizzare l'editor di testo, soprattutto per i file di grandi dimensioni."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktivering av syntaksmarkering kan forbedre ytelsen ved å redusere behandlingstidene som kreves for å gjengi tekstredigereren, spesielt for store filer."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "value" : "停用語法高亮顯示可以透過減少渲染文字編輯器的處理所需來提高效能，特別是對於大檔案。",
            "state" : "translated"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativar a realce da sintaxe pode melhorar o desempenho ao reduzir o processamento necessário para renderizar o editor de texto, especialmente para ficheiros grandes."
          }
        },
        "hi-IN" : {
          "stringUnit" : {
            "value" : "सिंटैक्स हाइलाइटिंग को अक्षम करने से टेक्स्ट एडिटर को प्रस्तुत करने के लिए आवश्यक प्रसंस्करण को कम करके प्रदर्शन में सुधार हो सकता है, विशेष रूप से बड़ी फ़ाइलों के लिए।",
            "state" : "translated"
          }
        },
        "fr" : {
          "stringUnit" : {
            "value" : "La désactivation de l'overscrivage de la syntaxe peut améliorer les performances en réduisant le traitement nécessaire pour rendre l'éditeur de texte, en particulier pour les gros fichiers.",
            "state" : "translated"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vô hiệu hóa tô sáng cú pháp có thể cải thiện hiệu suất bằng cách giảm thiểu quá trình xử lý cần thiết để hiển thị trình chỉnh sửa văn bản, đặc biệt đối với các tệp lớn."
          }
        }
      }
    },
