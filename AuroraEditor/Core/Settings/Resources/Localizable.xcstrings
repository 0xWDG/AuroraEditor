    "Your current stashed changes on this branch will no longer be visible in Aurora Editor if the branch is renamed." : {
      "localizations" : {
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus cambios almacenados actuales en esta rama ya no serán visibles en el Editor Aurora si la rama recibe un nuevo nombre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perubahan tersimpan Anda saat ini di cabang ini tidak akan lagi terlihat di Aurora Editor jika cabang diganti namanya."
          }
        },
        "th" : {
          "stringUnit" : {
            "value" : "การเปลี่ยนแปลงที่ซ่อนไว้ในปัจจุบันของคุณในสาขานี้จะไม่ปรากฏใน Aurora Editor อีกต่อไปหากสาขาถูกเปลี่ยนชื่อ",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre aktuellen versteckten Änderungen an dieser Zweigstelle werden im Aurora Editor nicht mehr sichtbar sein, wenn der Zweig umbenannt wird."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "value" : "如果你改变了分支名称，在Aurora Editor中，你当前隐藏的这个分支的变化将不再可见。",
            "state" : "translated"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas alterações armazenadas neste ramo não serão mais visíveis no Editor Aurora se o ramo for renomeado."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uw huidige opgeslagen wijzigingen op deze tak zullen niet langer zichtbaar zijn in Aurora Editor als de tak wordt hernoemd."
          }
        },
        "ja-JP" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブランチの名前が変更された場合、このブランチの現在の保存されている変更は、Aurora Editorで表示されなくなります。"
          }
        },
        "it-CH" : {
          "stringUnit" : {
            "value" : "Se il ramo viene rinominato, l'editor Aurora non sarà in grado di vedere le modifiche che hai effettuato in questo ramo.",
            "state" : "translated"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şube yeniden adlandırılırsa, şubenizdeki mevcut saklanmış değişiklikler Aurora Editöründe artık görünmeyecektir."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "value" : "Toute modification que vous avez apportée à ce branche sera invisible dans l'éditeur Aurora s'il est renommé.",
            "state" : "translated"
          }
        },
        "hi-IN" : {
          "stringUnit" : {
            "value" : "यदि शाखा का नाम बदला जाता है तो इस शाखा पर आपके वर्तमान छिपे हुए परिवर्तन अब अरोड़ा संपादक में दिखाई नहीं देंगे।",
            "state" : "translated"
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus cambios almacenados actuales en esta rama ya no serán visibles en el Editor Aurora si la rama recibe un nuevo nombre."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cambios almacenados actuales en esta rama ya no serán visibles en el Editor Aurora si la rama se renombra."
          }
        },
        "ar-AE" : {
          "stringUnit" : {
            "value" : "لن تكون تغييراتك المخبأة الحالية على هذا الفرع مرئية في محرر أورورا إذا تمت إعادة تسمية الفرع.",
            "state" : "translated"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eventuelle ændringer, du foretager i denne gren, vil ikke længere være synlige i Aurora Editor, hvis grenen får et nyt navn."
          }
        },
        "uk-UA" : {
          "stringUnit" : {
            "value" : "Ваші поточні заховані зміни в цій гілці більше не відображатимуться в редакторі Aurora, якщо гілка буде перейменована.",
            "state" : "translated"
          }
        },
        "de-CH" : {
          "stringUnit" : {
            "value" : "Aurora Editor zeigt Ihre aktuellen versteckten Änderungen an dieser Zweigstelle nicht mehr an, wenn der Name der Zweigstelle geändert wird.",
            "state" : "translated"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modifiche che hai salvato in questo ramo non saranno più visibili in Aurora Editor se il ramo verrà rinominato."
          }
        },
        "sv" : {
          "stringUnit" : {
            "value" : "Om grenen byts namn kommer alla dina lagrade ändringar i den här grenen inte längre att synas i Aurora Editor.",
            "state" : "translated"
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eventuelle lagrede endringer i denne grenen vil ikke lenger være synlige i Aurora Editor dersom grenen får nytt navn."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "value" : "如果分支名稱被改了，您目前存儲在此分支上的更改將不再在Aurora Editor中可見。",
            "state" : "translated"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos modifications stockées actuelles sur cette branche ne seront plus visibles dans l'éditeur Aurora si la branche est renommée."
          }
        },
        "vi" : {
          "stringUnit" : {
            "value" : "Những thay đổi bạn lưu trữ hiện tại trên nhánh này sẽ không còn hiển thị trong Trình chỉnh sửa Aurora nếu nhánh này được đổi tên.",
            "state" : "translated"
          }
        },
        "pt" : {
          "stringUnit" : {
            "value" : "Suas alterações guardadas neste ramo não serão mais visíveis no Editor Aurora se o ramo for renomeado.",
            "state" : "translated"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши текущие схраненные изменения в этой ветке больше не будут видны в редакторе Aurora, если ветвь будет переименована."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje aktualne zmiany w tej gałęzi nie będą już widoczne w edytorze Aurora, jeśli nazwa gałęzi zostanie zmieniona."
          }
        },
        "ko-KR" : {
          "stringUnit" : {
            "value" : "지점이 이름이 변경되면 이 지점에서 저장된 변경 사항은 더 이상 오로라 에디터에서 보이지 않을 것입니다.",
            "state" : "translated"
          }
        }
      }
    },
