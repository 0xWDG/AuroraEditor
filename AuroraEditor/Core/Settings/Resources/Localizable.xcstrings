    "Your new branch will be based on your currently selected branch \"**%@**\"." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja nowa gałąź będzie oparta na aktualnie wybranej gałęzi \"**%@**\"."
          }
        },
        "hi-IN" : {
          "stringUnit" : {
            "value" : "आपकी नई शाखा आपकी वर्तमान में चयनित शाखा \"**%@**\" पर आधारित होगी।",
            "state" : "translated"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu novo ramo será baseado no seu ramo atualmente selecionado \"**%@**\"."
          }
        },
        "ar-AE" : {
          "stringUnit" : {
            "value" : "سيعتمد فرعك الجديد على الفرع الذي اخترته حاليا \"**%@**\".",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Ditt nya kontor kommer att baseras på ditt nuvarande valda kontor \"\"**%@**\"\".\""
          }
        },
        "id" : {
          "stringUnit" : {
            "value" : "Cabang baru Anda akan didasarkan pada cabang yang Anda pilih saat ini \"**%@**\".",
            "state" : "translated"
          }
        },
        "ja-JP" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の選択した支店「**%@**」に基づいて、新しい支店が作成されます。"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สาขาใหม่ของคุณจะขึ้นอยู่กับสาขาที่คุณเลือกในปัจจุบัน \"**%@**\""
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
