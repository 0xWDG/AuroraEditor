    "Try again later, it seems like at the moment GitHub is not returning anything." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "value" : "Daha sonra tekrar deneyin, GitHub'ın şu anda hiçbir şey geri vermiyor gibi görünüyor.",
            "state" : "translated"
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "value" : "Prøv igjen senere, det ser ut som GitHub for øyeblikket ikke returnerer noe.",
            "state" : "translated"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probeer het later nog eens, het lijkt erop dat GitHub op dit moment niets retourneert."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "value" : "Inténtalo de nuevo más tarde, parece que GitHub no está devolviendo nada en este momento.",
            "state" : "translated"
          }
        },
        "pt" : {
          "stringUnit" : {
            "value" : "Tente novamente mais tarde, parece que no momento o GitHub não está a devolver nada.",
            "state" : "translated"
          }
        },
        "da" : {
          "stringUnit" : {
            "value" : "Prøv igen senere, det ser ud til, at GitHub ikke returnerer noget i øjeblikket.",
            "state" : "translated"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повторите попытку позже, похоже, что на данный момент GitHub ничего не возвращает."
          }
        },
        "uk-UA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спробуйте ще раз пізніше, здається, що на даний момент GitHub нічого не повертає."
          }
        },
        "vi" : {
          "stringUnit" : {
            "value" : "Hãy thử lại sau, có vẻ như GitHub hiện không trả lại bất cứ thứ gì.",
            "state" : "translated"
          }
        },
        "hi-IN" : {
          "stringUnit" : {
            "value" : "बाद में फिर से कोशिश करें, ऐसा लगता है कि इस समय गिटहब कुछ भी वापस नहीं कर रहा है।",
            "state" : "translated"
          }
        },
        "it" : {
          "stringUnit" : {
            "value" : "Riprova più tardi, sembra che al momento GitHub non stia restituendo nulla.",
            "state" : "translated"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coba lagi nanti, sepertinya saat ini GitHub tidak mengembalikan apa pun."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veuillez réessayer plus tard, il semble que GitHub ne renvoie rien pour le moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "value" : "Inténtalo de nuevo más tarde, parece que GitHub no está devolviendo nada en este momento.",
            "state" : "translated"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Försök igen senare, det verkar som att GitHub för närvarande inte returnerar något."
          }
        },
        "ko-KR" : {
          "stringUnit" : {
            "value" : "나중에 다시 시도해봐, 현재로서는 GitHub가 아무 것도 반환하지 않는 것 같아.",
            "state" : "translated"
          }
        },
        "th" : {
          "stringUnit" : {
            "value" : "ลองอีกครั้งในภายหลัง ดูเหมือนว่าในขณะนี้ GitHub ไม่ได้ส่งคืนอะไรเลย",
