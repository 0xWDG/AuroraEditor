    "Hmmm... Seems Very Lonely Here, No Jobs Was Done It Looks Like." : {
      "localizations" : {
        "hi-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हम्म... यहां बहुत अकेला लगता है, ऐसा लगता है कि कोई काम नहीं किया गया था।"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çok yalnız görünüyor burada, göründüğü gibi hiç iş yapılmadı."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ummm… Parece muy solitario aquí, no se han hecho trabajos como parece."
          }
        },
        "uk-UA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хммм... Здається, Тут Дуже Самотньо, Жодної Роботи Не Було Зроблено, Схоже."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "value" : "On dirait qu'il y a beaucoup de solitude ici, sans boulot.",
            "state" : "translated"
          }
        },
        "it" : {
          "stringUnit" : {
            "value" : "Sembra molto solitario qui, sembra che non siano stati fatti lavori.",
            "state" : "translated"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "嗯......這裡似乎很孤獨，看起來沒有工作。"
          }
        },
        "ko-KR" : {
          "stringUnit" : {
            "value" : "음...여기가 매우 외롭게 보여요, 그처럼 일을 한 건 없어요.",
            "state" : "translated"
          }
        },
        "de" : {
          "stringUnit" : {
            "value" : "Es scheint sehr einsam zu sein hier, es scheint keine Jobs gemacht worden zu sein.",
